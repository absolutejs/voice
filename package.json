{
  "name": "@absolutejs/voice",
  "version": "0.0.22-beta.647",
  "description": "Voice primitives and Elysia plugin for AbsoluteJS",
  "repository": {
    "type": "git",
    "url": "https://github.com/absolutejs/voice.git"
  },
  "homepage": "https://github.com/absolutejs/voice",
  "bugs": {
    "url": "https://github.com/absolutejs/voice/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/manifest.ts ./src/client/index.ts ./src/react/index.ts ./src/vue/index.ts ./src/svelte/index.ts ./src/angular/index.ts ./src/testing/index.ts ./src/drizzle/index.ts --outdir dist --root ./src --target bun --external @absolutejs/ai --external '@absolutejs/ai/*' --external @absolutejs/manifest --external '@absolutejs/manifest/*' --external @absolutejs/media --external '@absolutejs/media/*' --external @angular/core --external '@angular/core/*' --external @sinclair/typebox --external '@sinclair/typebox/*' --external drizzle-orm --external 'drizzle-orm/*' --external elysia --external 'elysia/*' --external react --external 'react/*' --external vue --external 'vue/*' && bun build ./src/client/htmxBootstrap.ts --outdir dist/client --target browser --format esm && bun build ./src/embed/index.ts --outfile dist/embed/voice-widget.js --target browser --format iife --minify && bun build ./src/embed/index.ts --outdir dist/embed --target browser --format esm && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
    "config": "absolute config",
    "format": "absolute prettier --write",
    "knip": "knip",
    "lint": "absolute eslint",
    "release": "bun run check:package && npm publish --access public --tag beta",
    "test": "bun test ./test/local-network/*.test.ts && bun test ./test/*.test.ts",
    "test:adapters": "bun test ./test/live/*.test.ts",
    "test:assemblyai": "bun test ./test/live/assemblyai.live.test.ts",
    "test:deepgram": "bun test ./test/live/deepgram.live.test.ts",
    "test:elevenlabs": "bun test ./test/live/elevenlabs.live.test.ts",
    "test:openai": "bun test ./test/live/openai.live.test.ts",
    "typecheck": "absolute typecheck",
    "verify-package": "absolute-manifest verify-package",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run verify-package && bun run build && bun run verify-package --artifacts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "browser": "./dist/client/index.js",
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./react": {
      "browser": "./dist/react/index.js",
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./vue": {
      "browser": "./dist/vue/index.js",
      "import": "./dist/vue/index.js",
      "types": "./dist/vue/index.d.ts"
    },
    "./svelte": {
      "import": "./dist/svelte/index.js",
      "types": "./dist/svelte/index.d.ts"
    },
    "./angular": {
      "import": "./dist/angular/index.js",
      "types": "./dist/angular/index.d.ts"
    },
    "./drizzle": {
      "import": "./dist/drizzle/index.js",
      "types": "./dist/drizzle/index.d.ts",
      "default": "./dist/drizzle/index.js"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    },
    "./embed": {
      "browser": "./dist/embed/index.js",
      "import": "./dist/embed/index.js",
      "types": "./dist/embed/index.d.ts"
    },
    "./embed/voice-widget.js": "./dist/embed/voice-widget.js",
    "./manifest": {
      "import": "./dist/manifest.js",
      "types": "./dist/manifest.d.ts"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/index.d.ts"
      ],
      "client": [
        "dist/client/index.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "svelte": [
        "dist/svelte/index.d.ts"
      ],
      "vue": [
        "dist/vue/index.d.ts"
      ],
      "angular": [
        "dist/angular/index.d.ts"
      ],
      "drizzle": [
        "dist/drizzle/index.d.ts"
      ],
      "embed": [
        "dist/embed/index.d.ts"
      ],
      "manifest": [
        "dist/manifest.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "@absolutejs/ai": ">=0.0.5",
    "@angular/core": ">=21 <23",
    "drizzle-orm": ">=1.0.0-rc.4 <2",
    "elysia": ">=1.4.29 <2",
    "react": ">=19 <20",
    "vue": ">=3.5 <4"
  },
  "peerDependenciesMeta": {
    "@absolutejs/ai": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@absolutejs/manifest": "0.7.2",
    "@absolutejs/media": "0.0.1-beta.23",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@absolutejs/absolute": "0.19.0-beta.1115",
    "@absolutejs/ai": "0.0.47",
    "@angular/core": "22.0.8",
    "@electric-sql/pglite": "^0.4.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.0",
    "@typescript-eslint/parser": "^8.57.2",
    "drizzle-orm": "1.0.0-rc.4",
    "elysia": "1.4.29",
    "eslint": "^10.1.0",
    "eslint-plugin-absolute": "0.11.0-beta.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.4.0",
    "knip": "^6.14.1",
    "prettier": "^3.4.0",
    "react": "19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vue": "3.5.40"
  },
  "absolutejs": {
    "manifestContract": 2,
    "runtimePeers": {
      "@absolutejs/ai": {
        "artifactImports": [],
        "buildExternals": [
          "@absolutejs/ai",
          "@absolutejs/ai/*"
        ],
        "optional": true,
        "range": ">=0.0.5",
        "tested": "0.0.47"
      },
      "@angular/core": {
        "artifactImports": [
          "@angular/core"
        ],
        "buildExternals": [
          "@angular/core",
          "@angular/core/*"
        ],
        "optional": true,
        "range": ">=21 <23",
        "tested": "22.0.8"
      },
      "drizzle-orm": {
        "artifactImports": [
          "drizzle-orm",
          "drizzle-orm/pg-core"
        ],
        "buildExternals": [
          "drizzle-orm",
          "drizzle-orm/*"
        ],
        "optional": true,
        "range": ">=1.0.0-rc.4 <2",
        "tested": "1.0.0-rc.4"
      },
      "elysia": {
        "artifactImports": [
          "elysia"
        ],
        "buildExternals": [
          "elysia",
          "elysia/*"
        ],
        "optional": false,
        "range": ">=1.4.29 <2",
        "tested": "1.4.29"
      },
      "react": {
        "artifactImports": [
          "react",
          "react/jsx-dev-runtime"
        ],
        "buildExternals": [
          "react",
          "react/*"
        ],
        "optional": true,
        "range": ">=19 <20",
        "tested": "19.2.8"
      },
      "vue": {
        "artifactImports": [
          "vue"
        ],
        "buildExternals": [
          "vue",
          "vue/*"
        ],
        "optional": true,
        "range": ">=3.5 <4",
        "tested": "3.5.40"
      }
    }
  }
}
